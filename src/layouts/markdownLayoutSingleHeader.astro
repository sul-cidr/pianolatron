---
import StanfordHeader from "./stanfordHeader.astro";
import StanfordFooter from "./stanfordFooter.astro";
import DocNav from "../pages/docNav.astro";

import "../styles/styles.scss";
---

<style>
  main {
    color: var(--black);
    font-family: "Source Sans Pro", sans-serif;
    margin: 0 auto;
    max-width: 80%;
    min-height: calc(100vh - 30px - 69px - 193px);
    padding: 1em 1em;
    position: relative;
  }
</style>

<script>
  const { theme } =
    JSON.parse(window.localStorage.getItem("userSettings")) || {};
  theme && document.documentElement.setAttribute("data-theme", theme);
</script>

<body>
  <StanfordHeader />
  <DocNav />
  <main>
    <slot />
  </main>
  <StanfordFooter />
</body>
