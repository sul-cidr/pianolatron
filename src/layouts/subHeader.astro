---
const { tourClass } = Astro.props;
---

<header class="masthead image-masthead" role="banner">
  <span
    class="background-container"
    style="background-color: #6a2718"></span>
  <span class="background-container-gradient"></span>

  <div class="container site-title-container">
    <div class="site-title-wrapper">
      <img src="/pianolatron_logo.png" height="81px" alt="Pianolatron logo">
    </div>
  </div>
  <div
    id="exhibit-navbar"
    class="exhibit-navbar navbar navbar-light navbar-expand-md"
    role="navigation"
    aria-label="Exhibit navigation"
  >
    <div class="container">
      <ul class="navbar-nav mr-auto">
        <li class="nav-item">
          <a class="nav-link" href="https://exhibits.stanford.edu/piano-roll-program/feature/explore-the-collection">Search</a>
        </li>
        <li class="nav-item">
          <a class="nav-link external" href="https://exhibits.stanford.edu/piano-roll-program">Home</a
          >
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/howto/">Using Pianolatron</a>
        </li>
        <li class=`nav-item ${tourClass}`>
          <button class="link-button" id="tour-button">Tour</button>
        </li>
      </ul>
    </div>
  </div>
</header>

<style>
  .masthead {
    background-color: #2e2d29;
    font-size: small;
    height: 135px;
    overflow: hidden;
    padding: 0;
    position: relative;
    transition: height 0.3s ease;
  }
  
  body.header-hidden .masthead {
    height: 0;
  }
  .background-container {
    position: absolute;
    left: 0;
    right: 0;
    display: block;
    width: auto;
    height: inherit;
    background-repeat: no-repeat;
    background-size: cover;
    border-right: 1px solid #2e2d29;
    filter: blur(1px);
    height: 100%;
    margin-left: -1px;
    margin-top: -1px;
    overflow: hidden;
  }
  .background-container-gradient {
    position: absolute;
    left: 0;
    right: 0;
    display: block;
    width: auto;
    height: inherit;
    background: linear-gradient(
      rgba(0, 0, 0, 0),
      rgba(0, 0, 0, 0.4),
      rgba(0, 0, 0, 0.5)
    );
    height: 100%;
  }
  .site-title-container {
    max-height: 8rem;
    padding: 0.5rem 1.5rem !important;
  }
  .site-title-wrapper {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 0 0 1em;
    position: relative;
    color: #fff;
    display: flex;
    flex-direction: row;
    align-items: baseline;
  }
  .navbar {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 1rem;
    margin: 0 auto;
    background-color: rgba(0, 0, 0, 0.25);
  }
  .navbar .container {
    width: 1140px;
    padding: 0 1rem 0 1rem;
    margin: 0 auto;
  }
  .navbar-nav {
    display: flex;
    flex-direction: row;
    gap: 5rem;
    padding-left: 0;
    margin: 0;
    list-style: none;
  }
  .navbar-nav li {
    line-height: unset;
  }
  .navbar-nav li a,button {
    color: #ffffff;
    text-decoration: none;
    filter: brightness(0) invert(86%) sepia(0%) saturate(0%) hue-rotate(0deg) contrast(100%);
    font-family: SourceSans3, sans-serif;
    font-size: 15px;
    letter-spacing: 1.1px;
  }
  .navbar-nav li a.external {
    background-image: url(/link-external-small-ltr-progressive.svg);
    background-position: center right;
    background-repeat: no-repeat;
    background-size: 0.857em;
    padding-right: 1em;
  }
  .navbar-nav .nav-link:hover {
    text-decoration: underline;
  }
  .nav-item {
    white-space: nowrap;
  }
  .nav-item-right {
    margin: 0 0 0 auto;
  }
  .link-button {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    text-decoration: none;
    cursor: pointer;
    display: inline;
  }
  .link-button:hover {
    text-decoration: underline;
  }
  .tour-disabled {
    pointer-events: none;
    visibility: hidden;
  }
</style>
