---
import BaseLayout from "../layouts/base.astro";
import LoadingSpinner from "../ui-components/LoadingSpinner.svelte";
import Pianolatron from "../Pianolatron.svelte";
import StanfordSubheader from "../layouts/subHeader.astro";
import SkipLink from "../ui-components/SkipLink.svelte";

---

<BaseLayout title="Pianolatron" theme="cardinal">
  <LoadingSpinner
    showLoadingSpinner={true}
    loadingSpinnerText="Loading application..."
  />
  <SkipLink targetAnchor="app" skipText="Skip to main content" />
  <StanfordSubheader/>
  <Pianolatron client:only="svelte" mode="listen" />
</BaseLayout>
