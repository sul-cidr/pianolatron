---
import BaseLayout from "../../layouts/base.astro";
import Search from "../../components/Search.svelte";
import StanfordSubheader from "../../layouts/subHeader.astro";
import StanfordFooter from "../../layouts/stanfordFooter.astro";
import SkipLink from "../../ui-components/SkipLink.svelte";
---

<BaseLayout title="Pianolatron Search" theme="blue">
  <SkipLink />
  <StanfordSubheader />
  <main id="content">
    <Search client:only="svelte" />
  </main>
  <StanfordFooter />
</BaseLayout>

<style>
  body {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  main {
    flex-grow: 1;
  }
</style>
